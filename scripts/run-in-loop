#!/bin/bash

set -euo pipefail
. /.functions

# The PID of the process we're currently waiting on (the command, or the sleep)
CHILD_PID=""

# The signal that caused us to stop, if any
TERMINATED_BY=""

#
# Forward the received signal to the running child, and flag the loop for termination.
# The signal is NOT acted upon here beyond forwarding it: the main flow will
# notice that wait was interrupted, wait for the child to actually exit, and
# then exit cleanly.
#
handle_signal()
{
	local SIG="${1}"
	[ -n "${TERMINATED_BY}" ] || TERMINATED_BY="${SIG}"
	err "Received SIG${SIG}"
	[ -n "${CHILD_PID}" ] || return 0
	eyes "Forwarding SIG${SIG} to PID ${CHILD_PID}"
	kill -s "${SIG}" -- "${CHILD_PID}" &>/dev/null || true
}

#
# usage: run_child command [args...]
#
# Run the given command in the background and wait for it to exit, while
# allowing the signal traps to fire while it runs. Its exit status is
# returned. If a signal is received, it's forwarded to the child, and we
# keep waiting until the child actually exits.
#
run_child()
{
	# Explicitly re-attach stdin, since background jobs get /dev/null otherwise.
	# Background jobs also have SIGINT and SIGQUIT ignored (as job control is
	# off), so restore their default handling so they can be forwarded. Job
	# control isn't used because it puts the child in a background process
	# group, so it would be stopped (and we'd spin) if it read from a terminal.
	env --default-signal=INT,QUIT "${@}" <&0 &
	CHILD_PID="${!}"

	# If wait is interrupted by a trapped signal, the child is still
	# alive (or not yet reaped), so we wait on it again until it's gone
	while kill -0 "${CHILD_PID}" &>/dev/null ; do
		wait "${CHILD_PID}" 2>/dev/null || true
	done

	# The child is gone, so this returns its actual exit status (bash keeps
	# it), even if the last wait above was interrupted by a signal
	local RC=0
	wait "${CHILD_PID}" 2>/dev/null || RC=${?}
	CHILD_PID=""
	return ${RC}
}

terminate_if_signaled()
{
	[ -n "${TERMINATED_BY}" ] || return 0
	local ITERATION="${1}"
	err "Process Terminated by SIG${TERMINATED_BY} during iteration # ${ITERATION}"
	# Mimic the conventional exit status for death-by-signal
	exit $(( 128 + $(kill -l "${TERMINATED_BY}") ))
}

terminate_if_requested()
{
	local FILE="${1}"
	local ITERATION="${2}"
	terminate_if_signaled "${ITERATION}"
	is_file "${FILE}" && quit "The termination flag [${FILE}] was detected, stopping after iteration # ${ITERATION}"
	return 0
}

usage()
{
	echo -e "usage: ${BASH_ARGV0:-${BASH_SOURCE:-${0}}} command [args]"
	exit 1
}

[ ${#} -ge 1 ] || usage

set_or_default RUN_LOOP_WAIT "5s"
RUN_LOOP_WAIT_SECS="$(timestr_to_secs "${RUN_LOOP_WAIT}")" || fail "The value [${RUN_LOOP_WAIT}] for RUN_LOOP_WAIT is neither a valid number of seconds, nor a valid time string (\${DAYS}d\${HOURS}h\${MINUTES}m\${SECONDS}s)"

# Convert it back, just to make sure we have a timestring here
RUN_LOOP_WAIT="$(secs_to_timestr "${RUN_LOOP_WAIT_SECS}")"

set_or_default LOOP_TERMINATION_FILE "/tmp/.terminate"

# SIGKILL and SIGSTOP can't be trapped, so they can't be forwarded
for SIG in TERM INT QUIT HUP ; do
	trap "handle_signal ${SIG}" "${SIG}"
done

eyes "The command will run in an endless loop with a ${RUN_LOOP_WAIT} wait between iterations"
ITERATION=0
while true ; do
	terminate_if_requested "${LOOP_TERMINATION_FILE}" "${ITERATION}"

	(( ++ITERATION ))
	running "Iteration # ${ITERATION}: ${*@Q}"
	run_child "${@}" && ok "Exited with status code 0" || err "Exited with status code ${?}"
	terminate_if_signaled "${ITERATION}"
	[ ${RUN_LOOP_WAIT_SECS} -gt 0 ] || continue

	terminate_if_requested "${LOOP_TERMINATION_FILE}" "${ITERATION}"
	sleeping "Waiting ${RUN_LOOP_WAIT} before the next iteration"
	run_child sleep ${RUN_LOOP_WAIT_SECS} || { terminate_if_signaled "${ITERATION}" ; fail "Sleep interrupted" ; }
done
