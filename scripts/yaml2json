#!/usr/bin/python3

import datetime
import yaml
import json
import sys

# YAML dates and timestamps have no JSON equivalent, so render them as ISO-8601 strings
def json_default(o):
	if isinstance(o, (datetime.date, datetime.datetime)):
		return o.isoformat()
	raise TypeError(f"Object of type {type(o).__name__} is not JSON serializable")

try:
	documents = list(yaml.safe_load_all(sys.stdin))
	# An empty stream is rendered as null, as an empty document is
	if not documents:
		documents = [ None ]
	# A single document is rendered as-is. Multiple documents (separated by ---)
	# are rendered one per line (JSON Lines), which jq and others can consume
	for n, document in enumerate(documents):
		if n > 0:
			sys.stdout.write("\n")
		json.dump(document, sys.stdout, default=json_default)
except KeyboardInterrupt:
	sys.exit(1)
