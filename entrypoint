#!/bin/bash

set -euo pipefail
. /.functions

#
# Configure and verify the entrypoint
#
set_or_default ENTRYPOINT "/usr/local/bin/entrypoint"
require_file_executable "${ENTRYPOINT}"

#
# Init all the SSL-related stuff
#
init_ssl

#
# Make sure we wrap with tini
#
exec /usr/local/bin/with-tini "${ENTRYPOINT}" "${@}"
