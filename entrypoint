#!/bin/bash

set -euo pipefail
. /.functions

#
# Configure and verify the entrypoint
#
set_or_default ENTRYPOINT "/usr/local/bin/entrypoint"
require_file_executable "${ENTRYPOINT}"

#
# Init all the SSL-related stuff
#
# Allow some containers to turn off the SSL initialization in special circumstances
#
set_as_boolean SSL_INIT_DEFERRED "false"
as_boolean "${SSL_INIT_DEFERRED}" || init_ssl || fail "Failed to initialize the SSL layer"

#
# Make sure we wrap with tini
#
exec /usr/local/bin/with-tini "${ENTRYPOINT}" "${@}"
