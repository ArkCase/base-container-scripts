#!/bin/bash
set -euo pipefail
. /.functions

DEFAULT_MVN_CENTRAL_REPO="https://repo1.maven.org/maven2"

set_or_default DOWNLOAD_RETRY 30
set_or_default DOWNLOAD_RETRY_SEC 5
[[ "${DOWNLOAD_RETRY}" =~ ^[1-9][0-9]*$ ]] || fail "Invalid DOWNLOAD_RETRY value [${DOWNLOAD_RETRY}] - must be a positive number"
[[ "${DOWNLOAD_RETRY_SEC}" =~ ^(0|[1-9][0-9]*)$ ]] || fail "Invalid DOWNLOAD_RETRY_SEC value [${DOWNLOAD_RETRY_SEC}] - must be a non-negative number"

download()
{
	local URL="${1}"
	local AUTH="${2:-""}"
	local DEST="${3:-""}"
	# Quote the credentials properly for curl's config syntax (i.e. for spaces, quotes, etc.)
	[ -n "${AUTH}" ] && AUTH="$(auth_params "${AUTH}")"
	[ -n "${DEST}" ] && DEST=(--output "${DEST}")
	local ATTEMPT=0
	local RC=0
	local HTTP_CODE=""
	while true ; do
		(( ++ATTEMPT ))
		RC=0

		# All retries are handled by this loop, so curl doesn't retry on its own
		HTTP_CODE="$(curl \
			--location \
			--fail \
			--disallow-username-in-url \
			--write-out '%{http_code}' \
			--config <(echo -n "${AUTH}") \
			"${DEST[@]}" \
			"${URL}")" || RC=${?}

		# If there were no errors, return immediately
		[ ${RC} -eq 0 ] && return 0

		# If the error isn't retryable, fail immediately
		case ${RC} in
			# Connection refused, and transient network/transfer errors
			7 | 16 | 18 | 26 | 28 | 35 | 36 | 55 | 56 |  92 | 95 | 96 ) ;;

			# HTTP errors: only retry the transient ones
			22 )
				case "${HTTP_CODE}" in
					408 | 429 | 500 | 502 | 503 | 504 ) ;;
					* ) return ${RC} ;;
				esac
				;;

			* ) return ${RC} ;;
		esac

		# Retryable error ... but have we run out of attempts?
		[ ${ATTEMPT} -lt ${DOWNLOAD_RETRY} ] || break
		sleep ${DOWNLOAD_RETRY_SEC} || return ${?}
	done

	# We ran out of attempts, so return the last error
	return ${RC}
}

openssl_decrypt()
{
	local VAR_NAME="${1}"
	local REQUIRED="$(to_boolean "${2:-"false"}")"

	if as_boolean "${REQUIRED}" ; then
		[ -v MVN_GET_ENCRYPTION_KEY ] || fail "No MVN_GET_ENCRYPTION_KEY value is set, cannot continue"
		[ -n "${MVN_GET_ENCRYPTION_KEY}" ] || fail "The MVN_GET_ENCRYPTION_KEY value is empty, cannot continue"
		[ -v "${VAR_NAME}" ] || fail "No variable named [${VAR_NAME}] is defined"
	fi

	local VALUE=""
	if [ -v "${VAR_NAME}" ] ; then
		VALUE="${!VAR_NAME}" || fail "Failed to read the value from [${VAR_NAME}]"
	fi

	[ -v MVN_GET_ENCRYPTION_KEY ] || local MVN_GET_ENCRYPTION_KEY=""
	if [ -n "${MVN_GET_ENCRYPTION_KEY}" ] ; then
		local OUT=""
		# The key isn't exported (see below), so hand it only to decrypt
		if OUT="$(echo -n "${VALUE}" | MVN_GET_ENCRYPTION_KEY="${MVN_GET_ENCRYPTION_KEY}" decrypt MVN_GET_ENCRYPTION_KEY "${VAR_NAME}" 2>&1)" ; then
			echo -n "${OUT}"
			return 0
		else
			local RC=${?}
			"${REQUIRED}" && fail "Failed to decrypt the value from [${VAR_NAME}] (rc=${RC}):\n${OUT}"
		fi
	fi

	# Nothing to decrypt with, or decryption failed but wasn't required
	echo -n "${VALUE}"
	return 0
}

#
# usage: xml_value FILE ELEMENT [ELEMENT ...]
#
# Output the text of the element at the given path (from the root). The
# elements are matched by their local names, so they're found whether the
# document uses a namespace or not (i.e. POMs without xmlns, or metadata
# written by newer versions of Maven)
#
xml_value()
{
	local FILE="${1}"
	shift
	local XPATH=""
	local E=""
	for E in "${@}" ; do
		XPATH+="/*[local-name()='${E}']"
	done
	xmlstarlet sel -t -v "${XPATH}" < "${FILE}"
}

cleanup()
{
	local RC=${?}
	[ -v WORKDIR ] && is_dir "${WORKDIR}" && rm -rf "${WORKDIR}" &>/dev/null
	return ${RC}
}

usage()
{
	{
		echo -e "usage: ${BASH_ARGV0:-${BASH_SOURCE:-${0}}} artifactSpec [repoUrl] target"
		echo -e ""
		echo -e "\t\tartifactSpec: groupId:artifactId[:version[:packaging[:classifier]]]"
		echo -e "\t\trepoUrl:      URL to the Maven repository housing the artifact (http:// or https://)"
		echo -e "\t\ttarget:       The final path where the file will be copied into. If it's"
		echo -e "\t\t              a directory, the downloaded filename will be preserved."
		echo -e ""
		echo -e "\t\tIf the repoUrl is not given, the repository specified by the MVN_CENTRAL_REPO"
		echo -e "\t\tenvironment variable will be used. If this variable is not set, empty, or invalid,"
		echo -e "\t\tthen the default Maven Central Repository URL at ${DEFAULT_MVN_CENTRAL_REPO}"
		echo -e "\t\twill be used."
	} 1>&2
	exit 1
}

[ ${#} -ge 2 ] && [ ${#} -le 3 ] || usage
if [ ${#} -eq 3 ] ; then
	ARTIFACT="${1}"
	REPO_URL="${2}"
	DEST="${3}"
else
	ARTIFACT="${1}"
	DEST="${2}"

	set_or_default MVN_CENTRAL_REPO
	[[ "${MVN_CENTRAL_REPO,,}" =~ ^https?:// ]] || MVN_CENTRAL_REPO="${DEFAULT_MVN_CENTRAL_REPO}"
	# TODO: More URL validation?
	REPO_URL="${MVN_CENTRAL_REPO}"
fi

[[ "${ARTIFACT}" =~ ^([^:[:space:]]+):([^:[:space:]]+)(:([^:[:space:]]+)?(:([^:[:space:]]+)?(:([^:[:space:]]+)?)?)?)?$ ]] || fail "The artifact string [${ARTIFACT}] is not valid"
GROUP_ID="${BASH_REMATCH[1]}"
ARTIFACT_ID="${BASH_REMATCH[2]}"
VERSION="${BASH_REMATCH[4]}"
EXTENSION="${BASH_REMATCH[6]}"
CLASSIFIER="${BASH_REMATCH[8]}"

[ -n "${VERSION}" ] || VERSION="RELEASE"

require_exe xmlstarlet xmllint curl

# The credentials (and the key that decrypts them) are only for our own use, so
# keep them out of the environment of every child process (curl, render-helpers, etc.)
export -n AUTH MVN_GET_USERNAME MVN_GET_PASSWORD MVN_GET_ENCRYPTION_KEY

NEED_DECRYPT="true"
if [ -v MVN_GET_SERVER_ID ] ; then
	# We have a server ID whose username/password combo we wish to consume
	[ -n "${MVN_GET_SERVER_ID}" ] || fail "The value in MVN_GET_SERVER_ID may not be the empty string"
	require_exe mvn-crypt
	MVN_GET_USERNAME="$(mvn-crypt --quiet server decrypt "${MVN_GET_SERVER_ID}" username)" || fail "Failed to decrypt the username for the server [${MVN_GET_SERVER_ID}] (rc=${?})"
	[ -n "${MVN_GET_USERNAME}" ] || fail "The username for server [${MVN_GET_SERVER_ID}] is empty or nonexistent"
	MVN_GET_PASSWORD="$(mvn-crypt --quiet server decrypt "${MVN_GET_SERVER_ID}" password)" || fail "Failed to decrypt the password for the server [${MVN_GET_SERVER_ID}] (rc=${?})"
	[ -n "${MVN_GET_PASSWORD}" ] || fail "The password for server [${MVN_GET_SERVER_ID}] is empty or nonexistent"
	NEED_DECRYPT="false"
	ok "Decrypted the username and password for the server ${MVN_GET_SERVER_ID} from Maven's settings"
fi

AUTH=""
if [ -v MVN_GET_USERNAME ] && [ -v MVN_GET_PASSWORD ] ; then
	[ -n "${MVN_GET_USERNAME}" ] || fail "The value in MVN_GET_USERNAME may not be the empty string"
	[ -n "${MVN_GET_PASSWORD}" ] || fail "The value in MVN_GET_PASSWORD may not be the empty string"

	# If we need to decrypt values, now is the time
	if "${NEED_DECRYPT}" ; then
		# We only do this if it hasn't already been done by MVN_CRYPT, above ...
		MVN_GET_USERNAME="$(openssl_decrypt MVN_GET_USERNAME 2>&1)" || fail "Failed to decrypt the value in MVN_GET_USERNAME:\n${MVN_GET_USERNAME}"
		ok "Decrypted the username with OpenSSL"
		MVN_GET_PASSWORD="$(openssl_decrypt MVN_GET_PASSWORD "true" 2>&1)" || fail "Failed to decrypt the value in MVN_GET_PASSWORD\n${MVN_GET_PASSWORD}"
		ok "Decrypted the password with OpenSSL"
	fi

	# Join everything together into happy matrimony
	AUTH="${MVN_GET_USERNAME}:${MVN_GET_PASSWORD}"
fi

[[ "${REPO_URL,,}" =~ ^https?:// ]] || fail "Repository [${REPO_URL}] from artifact parameter [${ARTIFACT}] is not valid"

GROUP_PATH="${GROUP_ID//./\/}"
BASE="${REPO_URL}/${GROUP_PATH}/${ARTIFACT_ID}"

doing "Downloading:"
say "\tArtifact:    [${ARTIFACT}]"
say "\tRepository:  [${REPO_URL}]"
say "\tDestination: [${DEST}]"
if [ -n "${AUTH}" ] ; then
	# Only the username's hash is shown: an unsalted hash of the password
	# would allow it to be guessed offline by anyone who can read the logs
	USUM="$(echo -n "${AUTH}" | sed -e 's;:.*$;;g' | sha256sum | awk '{ print $1 }')"
	say "\tAuthentication:"
	say "\t🔒 Username: [${USUM}] (sha256 sum)"
	say "\t🔑 Password: [set]"
else
	say "\tNo authentication will be used"
fi

export WORKDIR="$(mktemp -d)"
trap cleanup EXIT

FINAL_VERSION="${VERSION}"
SUPPORT_SNAPSHOT="true"
if [ "${VERSION}" == "LATEST" ] || [ "${VERSION}" == "RELEASE" ] ; then
	# This shouldn't be necessary, as the metadata should never reference SNAPSHOTS
	# in the <release> element, but we take precautions nonetheless
	[ "${VERSION}" == "RELEASE" ] && SUPPORT_SNAPSHOT="false"
	say "⚠️ Identifying the ${VERSION} artifact version to download..."

	RC=0
	XML="${WORKDIR}/maven-metadata.xml"
	OUT="$(download "${BASE}/maven-metadata.xml" "${AUTH}" "${XML}" 2>&1)" || RC=${?}
	[ ${RC} -eq 0 ] || fail "Failed to download the artifact metadata for ${GROUP_ID}:${ARTIFACT_ID} from [${BASE}/maven-metadata.xml] (rc=${RC}):\n${OUT}"
	xmllint "${XML}" &>/dev/null || fail "The artifact metadata for ${GROUP_ID}:${ARTIFACT_ID} downloaded from [${BASE}/maven-metadata.xml] is not valid XML"

	FINAL_VERSION="$(xml_value "${XML}" metadata versioning "${VERSION,,}")" || fail "Failed to identify the ${VERSION} version for ${GROUP_ID}:${ARTIFACT_ID} from the XML at [${BASE}/maven-metadata.xml]"
	say "\t✅ The ${VERSION} version is ${FINAL_VERSION}"
	VERSION="${FINAL_VERSION}"
fi

# If the final version is a snapshot, then we must resolve that
BASE+="/${VERSION}"
if "${SUPPORT_SNAPSHOT}" && [[ "${VERSION^^}" =~ (^|[^a-zA-Z0-9])SNAPSHOT$ ]] ; then
	say "⚠️ This version is a SNAPSHOT - identifying the final artifact to download"

	RC=0
	XML="${WORKDIR}/maven-metadata.xml"
	OUT="$(download "${BASE}/maven-metadata.xml" "${AUTH}" "${XML}" 2>&1)" || RC=${?}
	[ ${RC} -eq 0 ] || fail "Failed to download the artifact metadata for ${GROUP_ID}:${ARTIFACT_ID}:${VERSION} from [${BASE}/maven-metadata.xml] (rc=${RC}):\n${OUT}"
	xmllint "${XML}" &>/dev/null || fail "The artifact metadata for ${GROUP_ID}:${ARTIFACT_ID} downloaded from [${BASE}/maven-metadata.xml] is not valid XML"

	TIMESTAMP="$(xml_value "${XML}" metadata versioning snapshot timestamp)" || fail "No timestamp data is present for the required snapshot version, cannot continue"
	BUILD_NUMBER="$(xml_value "${XML}" metadata versioning snapshot buildNumber)" || fail "No build number data is present for the required snapshot version, cannot continue"
	FINAL_VERSION="$(echo -n "${VERSION}" | /usr/bin/sed -e "s/\(\b\)SNAPSHOT\(\b\)/\1${TIMESTAMP}-${BUILD_NUMBER}\2/gi")"
	say "\t✅ The latest SNAPSHOT version is ${FINAL_VERSION}"
fi

BASE="${BASE}/${ARTIFACT_ID}-${FINAL_VERSION}"
TAB=""
if [ -z "${EXTENSION}" ] ; then
	say "⚠️ Packaging (type) not provided, will attempt to identify it from the POM"

	RC=0
	POM="${WORKDIR}/file.pom"
	OUT="$(download "${BASE}.pom" "${AUTH}" "${POM}" 2>&1)" || RC=${?}
	[ ${RC} -eq 0 ] || fail "Failed to download the artifact POM for ${GROUP_ID}:${ARTIFACT_ID}:${VERSION} from [${BASE}.pom] (rc=${RC}):\n${OUT}"
	xmllint "${POM}" &>/dev/null || fail "The artifact POM for ${GROUP_ID}:${ARTIFACT_ID}:${VERSION} downloaded from [${BASE}.pom] is not valid XML"

	TAB="\t"
	EXTENSION="$(xml_value "${POM}" project packaging)" || true
	[ -z "${EXTENSION}" ] && EXTENSION="jar"

	# Some packaging types don't match the file extension of the artifact they produce
	case "${EXTENSION}" in
		bundle | maven-plugin | ejb | eclipse-plugin | maven-archetype ) EXTENSION="jar" ;;
	esac
fi
say "${TAB}✅ Will download the ${EXTENSION} artifact"

# Must be given explicitly ...
if [ -n "${CLASSIFIER}" ] ; then
	say "✅ The classifier is ${CLASSIFIER}"
	CLASSIFIER="-${CLASSIFIER}"
fi

URL="${BASE}${CLASSIFIER}.${EXTENSION}"
FILENAME="${URL##*/}"

# Check to see if the destination is
if [ -e "${DEST}" ] ; then
	if [ -d "${DEST}" ] ; then
		# It's a directory, so preserve the artifact's filename
		DEST="$(readlink -f "${DEST}")/${FILENAME}"
	elif [ -f "${DEST}" ] ; then
		# It's a file, so clobber it
		DEST="$(readlink -f "${DEST}")"
	else
		fail "The target path at [${DEST}] is neither a directory nor a regular file, cannot continue"
	fi
else
	# It doesn't exist ... check to see if the parent exists ... if it
	# does, and is a directory, then we use DEST as the full filename.
	PARENT="$(dirname "${DEST}")"
	[ -e "${PARENT}" ] || mkdir -p "${PARENT}" || fail "Failed to create the parent directory [${PARENT}] ... can't save the download into [${DEST}]"
	[ -d "${PARENT}" ] || fail "The path [${PARENT}] is not a directory ... can't save the download into [${DEST}]"
	PARENT="$(readlink -f "${PARENT}")"
	DEST="${PARENT}/$(basename "${DEST}")"
fi

doing "Final Version: [${FINAL_VERSION}]"
doing "Final File:    [${DEST}]"
doing "Final URL:     [${URL}]"
# Download into the work directory first, so a failed download can't clobber an existing file
DOWNLOADED="${WORKDIR}/${FILENAME}"
download "${URL}" "${AUTH}" "${DOWNLOADED}" || fail "Failed to complete the download (rc=${?})"
mv -f "${DOWNLOADED}" "${DEST}" || fail "Failed to move the downloaded file into [${DEST}] (rc=${?})"
ok "Download successful!"
type -P render-helpers &>/dev/null || exit 0
cleanup || true
execute render-helpers "${DEST}" "${FINAL_VERSION}"
