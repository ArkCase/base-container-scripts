#!/bin/bash

set -euo pipefail
. /.functions

# Use the same termination marker as run-in-loop and terminate-run-loop
set_or_default LOOP_TERMINATION_FILE "/tmp/.terminate"
set_or_default MARKER "${LOOP_TERMINATION_FILE}"


# The marker's directory must already exist, since that's what gets watched
MARKER_DIR="$(dirname "${MARKER}")"
require_dir_readable "${MARKER_DIR}"
MARKER_DIR="$(readlink -f "${MARKER_DIR}")" || fail "Failed to resolve the path for the directory [${MARKER_DIR}]"
MARKER_NAME="$(basename "${MARKER}")"
MARKER="${MARKER_DIR}/${MARKER_NAME}"

sleeping "Sleeping until the marker file [${MARKER}] is created"

# The marker may already exist, or be created before the watch is set up, so
# check for it before every wait, and re-check periodically (via the timeout).
# Any event in the directory just triggers a new check for the marker.
while [ ! -e "${MARKER}" ] ; do
	RC=0
	OUT="$(inotifywait --quiet --timeout 10 --event close_write --event moved_to "${MARKER_DIR}" 2>&1)" || RC=${?}

	# 0 = an event happened, 2 = the wait timed out, anything else is an error
	case "${RC}" in
		0 | 2 ) ;;
		* ) fail "File wait failed (rc=${RC}): ${OUT}" ;;
	esac
done

require_file_readable "${MARKER}"

# If the marker is not empty, it may contain a number
# between 0 and 255 in which case it will be our exit status.
#
# Any other text will be translated as the exit status "1"
DATA="$(<"${MARKER}")" || fail "Failed to read the contents of the marker [${MARKER}]"
RC=0
# An empty marker == 0 exit status
if [ -n "${DATA}" ] ; then
	if [[ "${DATA}" =~ ^(0|[1-9][0-9]*)$ ]] ; then
		# A marker number must be between 0 and 255, or it gets folded to 1
		RC="${DATA}"
		[ 0 -le ${RC} ] || { err "Marker number out of range: ${RC}" ; RC=1 ; }
		[ ${RC} -le 255 ] || { err "Marker number out of range: ${RC}" ; RC=1 ; }
	else
		# Non-numeric content, so spit it out, and exit with status 1
		RC=1
		eyes "Marker contents: [\n${DATA}\n]"
	fi
fi

#
# Exit with the correct status
#
[ ${RC} -eq 0 ] && quit "Wait terminated cleanly"
err "Wait terminating with exit status ${RC}"
exit ${RC}
