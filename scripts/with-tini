#!/bin/bash

set -euo pipefail
. /.functions

usage()
{
	[ ${#} -eq 0 ] || err "${*}\n"
	echo -e "usage: ${BASH_ARGV0:-${BASH_SOURCE:-${0}}} command [ args ... ]"
	exit 1
}

[ ${#} -gt 0 ] || usage "Must provide the command (and parameters) to wrap with tini"

set_or_default TINI_KILL_PROCESS_GROUP "1"
export TINI_KILL_PROCESS_GROUP

if [ ${$} != 1 ] ; then
	set_or_default TINI_SUBREAPER "1"
	export TINI_SUBREAPER
fi

#
# If we have any other special flags configured, apply them
#
set_or_default TINI_FLAGS
to_array TINI_FLAGS

#
# Become the command!
#
exec "/usr/bin/tini" "${TINI_FLAGS[@]}" -- "${@}"
